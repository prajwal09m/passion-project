[TEMPLATE]
# Model Autopsy — Meta AI is CORE (hackathon entry requires it).
# Local diagnostics run free without a key, but the scored Meta investigator
# turn ("Run Meta turn") requires MODEL_API_KEY. NEVER commit a real key.
# The frontend never sees this value.

# REQUIRED for Meta investigator (Muse Spark) — create at https://api.meta.ai (dev.meta.ai)
MODEL_API_KEY=

# Optional overrides (defaults shown)
MODEL_API_BASE_URL=https://api.meta.ai/v1
MODEL_API_MODEL_ID=muse-spark-1.3

# Read-only workspace roots for software-autopsy tools (":"-separated paths)
MODEL_AUTOPSY_ALLOWED_WORKSPACES=.
